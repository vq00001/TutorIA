# =============================================================================
# Servicios
# =============================================================================

# Puerto local donde Ollama expone su API.
OLLAMA_PORT=11434

# Puerto local donde Qdrant expone su API.
QDRANT_PORT=6333

# URLs de los servicios. Normalmente solo cambia los puertos de arriba.
OLLAMA_URL=http://localhost:${OLLAMA_PORT}
QDRANT_URL=http://localhost:${QDRANT_PORT}


# =============================================================================
# Modelos
# =============================================================================

# Modelo usado para generar respuestas y contexto opcional.
MODEL_LLM=qwen3:1.7b

# Modelo usado para generar embeddings. Debe estar disponible en Ollama.
MODEL_EMBED=all-minilm


# =============================================================================
# Almacenamiento
# =============================================================================

# Colección principal de vectores en Qdrant.
QDRANT_COLLECTION=document_chunks


# =============================================================================
# Chunking
# =============================================================================

# Tamaño aproximado de cada child en tokens. Debe ser menor que PARENT_MAX_TOKENS.
CHILD_TARGET_TOKENS=160

# Tamaño máximo aproximado de cada parent en tokens. Debe ser mayor que el child.
PARENT_MAX_TOKENS=1200

# Secciones menores a este valor se fusionan con una sección hermana. Mínimo: 0.
MIN_SECTION_TOKENS=60

# Proporción de solapamiento al cortar frases largas. Rango: 0 <= valor < 1.
OVERLAP_RATIO=0.12

# Multiplicador de tokens estimados sobre palabras y signos. Calibrar con experiments/.
TOKEN_ESTIMATE_RATIO=1.3

# Genera contexto adicional con MODEL_LLM antes de crear embeddings. Valores: true/false.
USE_CONTEXT=false


# =============================================================================
# Recuperación
# =============================================================================

# Cantidad máxima de parents recuperados por consulta. Debe ser mayor que 0.
LIMIT_QUERY=4

# Similitud mínima para aceptar un resultado. Rango: 0 <= valor <= 1.
SIMILARITY_THRESHOLD=0.5
