# =============================================================================
# Docker Compose
# =============================================================================

# Puertos publicados en el equipo host.
WEBAPP_PORT=8080
WEBAPP_DEV_PORT=5173
AI_GATEWAY_PORT=8000
SWAGGER_PORT=8081
OLLAMA_PORT=11434
LITELLM_PORT=4000

# Secretos del ai gateway (genera valores aleatorios antes de usarlo en producción).
LITELLM_MASTER_KEY=sk-cambia-esto
LITELLM_SALT_KEY=sk-cambia-esto-tambien
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# =============================================================================
# Backend RAG (opcional mientras el backend no sea un servicio de Compose)
# =============================================================================

# URLs usadas cuando el backend se ejecuta directamente en el host.
OLLAMA_URL=http://localhost:${OLLAMA_PORT}

# Ejecucion local (backend en el host)
# Cuando el backend es ejecutado como servicio en el docker compose usar
# http://litellm:4000 en su lugar
AI_GATEWAY_URL=http://localhost:${LITELLM_PORT}

# La llave que el backend manda al gateway. Sin una
# base de datos LLM solo acepta la llave maestra, por lo que debe coincidir con
# LITELLM_MASTER_KEY.
AI_GATEWAY_API_KEY=sk-cambia-esto

# Alias del gateway usado para el chat.
MODEL_LLM=chat-principal
MODEL_EMBED=all-minilm


# Parámetros del pipeline de chunking.
CHILD_TARGET_TOKENS=160
PARENT_MAX_TOKENS=1200
MIN_SECTION_TOKENS=60
OVERLAP_RATIO=0.12
TOKEN_ESTIMATE_RATIO=1.3
USE_CONTEXT=false

# Parámetros de recuperación.
LIMIT_QUERY=4
SIMILARITY_THRESHOLD=0.5

# PostgreSQL local. Ajusta DATABASE_URL si cambias el puerto o las credenciales.
DB_PORT=55432
POSTGRES_DB=tutoria
POSTGRES_USER=tutoria_migrator
POSTGRES_PASSWORD=tutoria_local_migrator
API_DB_PASSWORD=tutoria_local_api
WORKER_DB_PASSWORD=tutoria_local_worker
DATABASE_URL=postgresql+psycopg://tutoria_api:tutoria_local_api@127.0.0.1:55432/tutoria

# Correo de verificación y recuperación por SMTP con TLS implícito.
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
