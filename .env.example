# =============================================================================
# Docker Compose
# =============================================================================

# Puertos publicados en el equipo host.
WEBAPP_PORT=8080
WEBAPP_DEV_PORT=5173
AI_GATEWAY=8000
SWAGGER_PORT=8081
OLLAMA_PORT=11434
QDRANT_PORT=6333
LITELLM_PORT=4000

# Secretos del ai gateway (genera valores aleatorios antes de usarlo en producción).
LITELLM_MASTER_KEY=sk-cambia-esto
LITELLM_SALT_KEY=sk-cambia-esto-tambien
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# =============================================================================
# Backend RAG (opcional mientras el backend no sea un servicio de Compose)
# =============================================================================

# URLs usadas cuando el backend se ejecuta directamente en el host.
OLLAMA_URL=http://localhost:${OLLAMA_PORT}
QDRANT_URL=http://localhost:${QDRANT_PORT}

# Backend -> AI gateway (LiteLLM).
# Local run (backend on the host): host-mapped port.
# When the backend runs as a Compose service, use http://litellm:4000 instead.
AI_GATEWAY_URL=http://localhost:${LITELLM_PORT}

# Key the backend sends to the gateway. Without a database, LiteLLM only
# accepts its master key, so this must equal LITELLM_MASTER_KEY.
AI_GATEWAY_API_KEY=sk-cambia-esto

# Gateway alias used for chat (NOT an Ollama model name).
MODEL_LLM=chat-principal
MODEL_EMBED=all-minilm

# Colección principal de vectores en Qdrant.
QDRANT_COLLECTION=document_chunks

# Parámetros del pipeline de chunking.
CHILD_TARGET_TOKENS=160
PARENT_MAX_TOKENS=1200
MIN_SECTION_TOKENS=60
OVERLAP_RATIO=0.12
TOKEN_ESTIMATE_RATIO=1.3
USE_CONTEXT=false

# Parámetros de recuperación.
LIMIT_QUERY=4
SIMILARITY_THRESHOLD=0.5
