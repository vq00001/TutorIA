# =============================================================================
# Docker Compose
# =============================================================================

# Puertos publicados en el equipo host.
WEBAPP_PORT=8080
WEBAPP_DEV_PORT=5173
SWAGGER_PORT=8081
OLLAMA_PORT=11434

# =============================================================================
# Backend RAG (opcional mientras el backend no sea un servicio de Compose)
# =============================================================================

# URLs usadas cuando el backend se ejecuta directamente en el host.
OLLAMA_URL=http://localhost:${OLLAMA_PORT}

# Modelos disponibles en Ollama.
MODEL_LLM=qwen3:1.7b
MODEL_EMBED=all-minilm


# Parámetros del pipeline de chunking.
CHILD_TARGET_TOKENS=160
PARENT_MAX_TOKENS=1200
MIN_SECTION_TOKENS=60
OVERLAP_RATIO=0.12
TOKEN_ESTIMATE_RATIO=1.3
USE_CONTEXT=false

# Parámetros de recuperación.
LIMIT_QUERY=4
SIMILARITY_THRESHOLD=0.5

# PostgreSQL local. Ajusta DATABASE_URL si cambias el puerto o las credenciales.
DB_PORT=55432
POSTGRES_DB=tutoria
POSTGRES_USER=tutoria_migrator
POSTGRES_PASSWORD=tutoria_local_migrator
API_DB_PASSWORD=tutoria_local_api
WORKER_DB_PASSWORD=tutoria_local_worker
DATABASE_URL=postgresql+psycopg://tutoria_api:tutoria_local_api@127.0.0.1:55432/tutoria
